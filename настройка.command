#!/bin/zsh
# ЗВУК ВСЕГО КОМПЬЮТЕРА В ОТЗВУК — настройка в один заход.
#
# Зачем это вообще нужно. Браузер на маке не умеет брать системный звук: он
# отдаёт только звук одной вкладки, и это ограничение самой системы. Чтобы
# отдать прибору ВСЁ, что играет, нужен виртуальный звуковой кабель —
# BlackHole. После него для браузера это обычный вход, и прибор берёт его тем
# же способом, что микрофон.
#
# Скрипт делает то, что можно сделать надёжно, и честно говорит, где нужна
# твоя рука. Ничего не ломает: всё, что он меняет, меняется обратно одним
# переключением выхода в настройках звука.

set -e
эхо() { print -P "%F{green}$1%f" }
шаг() { print -P "\n%F{cyan}▸ $1%f" }
беда() { print -P "%F{red}$1%f" }

print -P "%B── отзвук · настройка системного звука ──%b\n"

шаг "1. Homebrew"
if command -v brew >/dev/null; then эхо "  есть"
else
  беда "  нет. Поставь с brew.sh и запусти скрипт снова."
  exit 1
fi

шаг "2. BlackHole — виртуальный звуковой кабель"
if [[ -d /Library/Audio/Plug-Ins/HAL/BlackHole2ch.driver ]]; then
  эхо "  уже стоит"
else
  print "  ставлю (спросит пароль — это установка драйвера)"
  brew install blackhole-2ch
  print "  перезапускаю звуковую службу, чтобы она его увидела"
  sudo killall coreaudiod || true
  sleep 2
fi

шаг "3. Переключалка выхода"
if command -v SwitchAudioSource >/dev/null; then эхо "  есть"
else brew install switchaudio-osx; fi

шаг "4. Проверяю, видит ли система BlackHole"
if SwitchAudioSource -a -t output | grep -q "BlackHole"; then
  эхо "  видит"
else
  беда "  не видит. Выполни: sudo killall coreaudiod — и запусти скрипт снова."
  exit 1
fi

шаг "5. Снимаю глушение со встроенных динамиков"
# Клавиши громкости действуют на выход ПО УМОЛЧАНИЮ. Пока им стоит BlackHole,
# у которого громкости нет вовсе, снять глушение с колонок нечем — поэтому
# переключаемся на них, снимаем, и уходим обратно.
БЫЛО=$(SwitchAudioSource -c -t output)
SwitchAudioSource -s "$(SwitchAudioSource -a -t output | grep -iE 'динамик|speaker' | head -1)" -t output >/dev/null 2>&1 || true
osascript -e 'set volume output muted false' -e 'set volume output volume 55' || true
эхо "  снято"

шаг "6. Ставлю выходом BlackHole"
SwitchAudioSource -s "BlackHole 2ch" -t output
эхо "  готово"

print -P "\n%B── всё ──%b"
print "Теперь весь звук компьютера идёт в прибор, а прибор — в колонки."
print "В окне отзвука нажми ⌥⇧m и разреши доступ (браузер называет любой"
print "звуковой вход микрофоном — отдельного разрешения для виртуального нет)."
print ""
print "Дальше: клавиша ' ведёт ROUTE в середину, на nodes, и крути XMOD."
print "Прибор начнёт делить входящий звук на целые — 1/3, 1/4, 1/5."
print ""
print "Вернуть как было: в настройках звука выбери выходом «Динамики»."
print "Чтобы слышать и оригинал, и обработку разом, собери в «Настройке"
print "Audio-MIDI» устройство с многими выходами из динамиков и BlackHole."
