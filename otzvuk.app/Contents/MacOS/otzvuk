#!/bin/zsh
# otzvuk.app — ЯРЛЫК, КОТОРЫЙ ВСЕГДА ЗАПУСКАЕТ ЖИВОЙ КОД.
#
# ЛЕЖИТ В РЕПОЗИТОРИИ, А НЕ НА СТОЛЕ. Корень вычисляется ИЗ СОБСТВЕННОГО
# МЕСТА: файл лежит в <корень>/otzvuk.app/Contents/MacOS/, значит четыре
# уровня вверх — корень. Перенесёшь папку, переименуешь, склонируешь на другую
# машину — ярлык поедет вместе с ней и продолжит работать. На столе достаточно
# ссылки сюда. Зашитый путь не поехал бы ни на GitHub, ни в новую папку.
#
# НЕ exec И С ОТВЯЗКОЙ (& и disown, в zsh это `&!`). С exec питон унаследовал
# бы PID оболочки бандла, и LaunchServices считал бы приложение запущенным всё
# время работы: повторный клик по ярлыку не дошёл бы сюда вовсе — `open` увидел
# бы «уже запущено» и послал активацию. Так что оболочка живёт доли секунды и
# выходит, а каждый клик правда что-то делает.
#
# ВТОРОЙ СЕРВЕР НЕ ПОДНИМАЕМ. Если порт уже занят, значит прибор раздаётся —
# нужно только окно. Иначе второй питон упал бы на «адрес занят», и клик
# кончился бы ничем.

set -e

fail() {
  /usr/bin/osascript -e 'on run argv
    display alert "отзвук не запустился" message (item 1 of argv) as critical
  end run' "$1" >/dev/null 2>&1
  exit 1
}

# Имена переменных ЛАТИНИЦЕЙ. У приложения, запущенного из дока, локаль пустая
# (LC_CTYPE=C), и кириллические буквы для zsh не буквы вовсе: присваивание он
# принимает за команду и падает с «no such file or directory».
APP="${0:A:h:h:h:h}"
[[ -f $APP/serve.py ]] || fail "рядом с ярлыком нет serve.py: $APP"

PORT=8781
cd $APP
if /usr/bin/nc -z 127.0.0.1 $PORT 2>/dev/null; then
  /usr/bin/python3 -c 'import serve; serve.okno()' &!
else
  /usr/bin/python3 serve.py --okno &!
fi
exit 0
